{%- liquid
  assign visible_collections = 0
-%}
<section class="alma-collection-banners page-width" aria-labelledby="AlmaCollectionBanners-{{ section.id }}">
  <header class="alma-collection-banners__heading">
    {%- if section.settings.eyebrow != blank -%}<p>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 id="AlmaCollectionBanners-{{ section.id }}">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="rte">{{ section.settings.intro }}</div>{%- endif -%}
  </header>
  <div class="alma-collection-banners__grid">
    {%- for block in section.blocks -%}
      {%- assign collection_handle = block.settings.collection.handle | default: block.settings.collection -%}
      {%- assign selected_collection = collections[collection_handle] -%}
      {%- if selected_collection != blank -%}
        {%- assign banner_image = selected_collection.featured_image -%}
        {%- if banner_image == blank and selected_collection.products_count > 0 -%}
          {%- assign banner_image = selected_collection.products.first.featured_image -%}
        {%- endif -%}
        {%- assign visible_collections = visible_collections | plus: 1 -%}
        <a class="alma-collection-banner" href="{{ selected_collection.url }}" {{ block.shopify_attributes }}>
          <div class="alma-collection-banner__media">
            {%- if banner_image != blank -%}
              {{ banner_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'alma-collection-banner__image', alt: banner_image.alt | default: selected_collection.title }}
            {%- endif -%}
          </div>
          <div class="alma-collection-banner__overlay">
            <p>{{ 'alma.nav.products' | t }}</p>
            <h2>{{ selected_collection.title | escape }}</h2>
            <span>{{ section.settings.link_label | escape }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if visible_collections == 0 -%}
    <p class="alma-collection-banners__empty">Select collections in the Theme Editor to populate this page.</p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "ALMA collection banners",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The ALMA collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore ALMA collections" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover collection" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection banner", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "ALMA collection banners" } ]
}
{% endschema %}
