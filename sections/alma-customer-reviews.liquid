<section class="alma-customer-reviews page-width" aria-labelledby="AlmaReviews-{{ section.id }}">
  <header class="alma-customer-reviews__heading">
    <p>From the ALMA community</p>
    <h2 id="AlmaReviews-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </header>
  <div class="alma-customer-reviews__grid">
    {%- for block in section.blocks -%}
      <article class="alma-customer-review" {{ block.shopify_attributes }}>
        <div class="alma-customer-review__stars" aria-label="Five out of five stars" role="img"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
        <blockquote>{{ block.settings.quote | escape }}</blockquote>
        <footer><strong>{{ block.settings.name | escape }}</strong>{% if block.settings.location != blank %}<span>{{ block.settings.location | escape }}</span>{% endif %}</footer>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "ALMA customer reviews",
  "tag": "section",
  "class": "alma-customer-reviews-section",
  "limit": 1,
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Kind words from Dubai"}
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type":"review",
      "name":"Customer review",
      "settings":[
        {"type":"textarea","id":"quote","label":"Review","default":"A beautiful, long-lasting scent that feels refined without ever being too much."},
        {"type":"text","id":"name","label":"Customer name","default":"Noura A."},
        {"type":"text","id":"location","label":"Location","default":"Jumeirah, Dubai"}
      ]
    }
  ],
  "presets":[{"name":"ALMA customer reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]
}
{% endschema %}
