<section class="alma-campaign" aria-labelledby="AlmaRitual-{{ section.id }}">
  <div class="alma-campaign__media">
    <div class="alma-campaign__frame">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'alma-campaign__image' }}
      {%- else -%}
        <img class="alma-campaign__image" src="{{ 'alma-campaign-hero.png' | asset_url }}" width="1683" height="934" alt="{{ 'alma.campaign_image_alt' | t }}" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
  <div class="alma-campaign__actions">
    {%- for block in section.blocks -%}
      {%- if block.type == 'buttons' and block.settings.button_label_1 != blank -%}
        <a class="alma-campaign__button" href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'button_label_1', value: block.settings.button_label_1 %}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="alma-ritual">
    <div class="alma-ritual__inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'heading' -%}
          <h2 id="AlmaRitual-{{ section.id }}" {{ block.shopify_attributes }}>{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'heading', value: block.settings.heading %}</h2>
        {%- endif -%}
      {%- endfor -%}
      <div class="alma-ritual__text rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'text_html', value: section.settings.text, richtext: true %}</div>
      {%- if section.settings.link_label != blank -%}
        <a class="alma-text-link alma-cta--text" href="{{ section.settings.link | default: collections['layering-kits'].url | default: routes.all_products_collection_url }}">
          <span class="alma-cta-label">
            <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
            <span class="alma-cta-label__text">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'link_label', value: section.settings.link_label %}</span>
            <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ALMA campaign & ritual",
  "tag": "section",
  "class": "alma-campaign-section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Campaign image","info":"The approved campaign artwork is used until you select an image. Recommended ratio: 1.8:1; keep products centred for mobile."},
    {"type":"richtext","id":"text","label":"Ritual introduction","default":"<p>Lotion, solid perfume and spray perfume come together on the skin. Layer each texture, one after another, to create a lasting fragrance ritual that feels entirely your own.</p>"},
    {"type":"text","id":"link_label","label":"Ritual link label","default":"Discover all fragrances"},
    {"type":"url","id":"link","label":"Ritual link"}
  ],
  "blocks": [
    {"type":"heading","name":"Ritual heading","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"A ritual, entirely yours"}]},
    {"type":"buttons","name":"Campaign button","limit":1,"settings":[{"type":"text","id":"button_label_1","label":"Label","default":"Shop now"},{"type":"url","id":"button_link_1","label":"Link"}]}
  ],
  "presets": [{"name":"ALMA campaign & ritual","blocks":[{"type":"heading"},{"type":"buttons"}]}]
}
{% endschema %}
