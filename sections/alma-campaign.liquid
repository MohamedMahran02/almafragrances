<section class="alma-campaign" aria-labelledby="AlmaRitual-{{ section.id }}">
  <div class="alma-campaign__media">
    <div class="alma-campaign__frame">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'alma-campaign__image' }}
      {%- else -%}
        <img class="alma-campaign__image" src="{{ 'alma-campaign-hero.png' | asset_url }}" width="1683" height="934" alt="ALMA spray and solid perfume in warm evening light" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="alma-campaign__actions">
      {%- for block in section.blocks -%}
        {%- if block.type == 'buttons' and block.settings.button_label_1 != blank -%}
          <a class="alma-campaign__button button button--secondary" href="{{ block.settings.button_link_1 | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.button_label_1 | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="alma-ritual">
    {%- for block in section.blocks -%}
      {%- if block.type == 'heading' -%}
        <h2 id="AlmaRitual-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
    {%- endfor -%}
    <div class="alma-ritual__text rte">{{ section.settings.text }}</div>
    {%- if section.settings.link_label != blank -%}
      <a class="alma-text-link" href="{{ section.settings.link | default: collections['layering-kits'].url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "ALMA campaign & ritual",
  "tag": "section",
  "class": "alma-campaign-section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Campaign image","info":"The approved campaign artwork is used until you select an image. Recommended ratio: 1.8:1; keep products centred for mobile."},
    {"type":"richtext","id":"text","label":"Ritual introduction","default":"<p>Lotion, solid perfume, spray perfume.<br/>Discover the art of layering with ALMA.</p>"},
    {"type":"text","id":"link_label","label":"Ritual link label","default":"Explore layering"},
    {"type":"url","id":"link","label":"Ritual link"}
  ],
  "blocks": [
    {"type":"heading","name":"Ritual heading","limit":1,"settings":[{"type":"text","id":"heading","label":"Heading","default":"A ritual, entirely yours"}]},
    {"type":"buttons","name":"Campaign button","limit":1,"settings":[{"type":"text","id":"button_label_1","label":"Label","default":"Discover the collection"},{"type":"url","id":"button_link_1","label":"Link"}]}
  ],
  "presets": [{"name":"ALMA campaign & ritual","blocks":[{"type":"heading"},{"type":"buttons"}]}]
}
{% endschema %}
