{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alma-favourites.js' | asset_url }}" defer="defer"></script>
<alma-favourites class="alma-favourites page-width">
  <h2 id="AlmaFavourites-{{ section.id }}">{{ section.settings.title | escape }}</h2>
  <div class="alma-favourites__tabs" aria-labelledby="AlmaFavourites-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- assign tab_products = block.settings.products | default: block.settings.collection.products -%}
      {%- if forloop.first or tab_products != blank -%}
      <a class="alma-favourites__tab" href="#AlmaPanel-{{ section.id }}-{{ block.id }}" id="AlmaTab-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- for block in section.blocks -%}
    {%- liquid
      assign chosen_products = block.settings.products
      if chosen_products == blank
        assign chosen_products = block.settings.collection.products
      endif
      if chosen_products == blank and forloop.first
        assign chosen_products = collections.all.products
      endif
    -%}
    {%- if forloop.first or chosen_products != blank -%}
    <div class="alma-favourites__panel" id="AlmaPanel-{{ section.id }}-{{ block.id }}" aria-labelledby="AlmaTab-{{ section.id }}-{{ block.id }}">
      <div class="alma-favourites__grid">
        {%- for product in chosen_products limit: section.settings.products_to_show -%}
          <article class="alma-product">
            <a class="alma-product__image-link" href="{{ product.url }}">
              {%- if product.featured_image -%}
                {%- assign image_alt = product.featured_image.alt | default: product.title -%}
                {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '240, 360, 540, 750, 1000', sizes: '(min-width: 1200px) 540px, (min-width: 750px) 45vw, 90vw', class: 'alma-product__image', alt: image_alt }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'alma-product__image placeholder-svg' }}
              {%- endif -%}
            </a>
            <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {%- if product.type != blank -%}<p class="alma-product__type">{{ product.type | escape }}</p>{%- endif -%}
            {% render 'price', product: product %}
            <a class="alma-text-link" href="{{ product.url }}">{{ section.settings.product_link_label | escape }}<span class="visually-hidden"> — {{ product.title | escape }}</span></a>
          </article>
        {%- else -%}
          {% comment %}Editorial fallback for an empty test store: no invented price, variant, stock, or purchase form.{% endcomment %}
          <article class="alma-product">
            <img class="alma-product__image" src="{{ 'alma-perfume-reference.jpg' | asset_url }}" width="3024" height="4032" loading="lazy" alt="ALMA spray perfume">
            <h3>Spray perfumes</h3><a class="alma-text-link" href="{{ routes.all_products_collection_url }}">Discover ALMA</a>
          </article>
          <article class="alma-product">
            <img class="alma-product__image" src="{{ 'alma-solid-reference.png' | asset_url }}" width="820" height="619" loading="lazy" alt="ALMA solid perfume">
            <h3>Solid perfumes</h3><a class="alma-text-link" href="{{ routes.all_products_collection_url }}">Discover ALMA</a>
          </article>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}
  {%- endfor -%}
</alma-favourites>
{% schema %}
{
  "name":"ALMA favourites",
  "settings":[
    {"type":"text","id":"title","label":"Heading","default":"ALMA favourites"},
    {"type":"range","id":"products_to_show","label":"Products per tab","min":2,"max":8,"step":2,"default":2},
    {"type":"text","id":"product_link_label","label":"Product link label","default":"Choose options"}
  ],
  "max_blocks":6,
  "blocks":[{"type":"collection","name":"Product tab","settings":[
    {"type":"text","id":"label","label":"Tab label","default":"All"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"product_list","id":"products","label":"Selected products","limit":8,"info":"Optional. Overrides the collection. Product availability and prices come from Shopify."}
  ]}],
  "presets":[{"name":"ALMA favourites","blocks":[{"type":"collection","settings":{"label":"All"}}]}]
}
{% endschema %}
