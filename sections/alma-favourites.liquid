{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alma-favourites.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_quick_add -%}<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>{%- endif -%}
<script src="{{ 'alma-scroll-gallery.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign has_collections = false
  assign best_selling_handle = section.settings.best_selling_collection.handle | default: section.settings.best_selling_collection | default: 'best-sellers'
  assign best_selling_collection = collections[best_selling_handle]
  if best_selling_collection == blank
    assign best_selling_collection = collections['best-sellers']
  endif
  if best_selling_collection == blank
    assign best_selling_collection = collections['best-selling']
  endif
  if best_selling_collection != blank
    assign has_collections = true
  endif
  if has_collections == false
    for block in section.blocks
      assign collection_handle = block.settings.collection.handle | default: block.settings.collection
      assign selected_collection = collections[collection_handle]
      if selected_collection != blank
        assign has_collections = true
        break
      endif
    endfor
  endif
-%}
{%- if has_collections -%}
<alma-favourites class="alma-favourites page-width">
  <h2 id="AlmaFavourites-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'title', value: section.settings.title %}</h2>
  <div class="alma-favourites__tabs" aria-labelledby="AlmaFavourites-{{ section.id }}">
    {%- if best_selling_collection != blank -%}
      <a class="alma-favourites__tab" href="#AlmaPanel-{{ section.id }}-best-sellers" id="AlmaTab-{{ section.id }}-best-sellers">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'best_selling_label', value: section.settings.best_selling_label %}</a>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign tab_handle = block.settings.collection.handle | default: block.settings.collection -%}
      {%- assign tab_collection = collections[tab_handle] -%}
      {%- if tab_collection != blank -%}
        <a class="alma-favourites__tab" href="#AlmaPanel-{{ section.id }}-{{ block.id }}" id="AlmaTab-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>{% if block.settings.label != blank %}{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'label', value: block.settings.label %}{% else %}{{ tab_collection.title | escape }}{% endif %}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if best_selling_collection != blank -%}
    {%- assign product_track_id = 'AlmaProducts-' | append: section.id | append: '-best-sellers' -%}
    <div class="alma-favourites__panel" id="AlmaPanel-{{ section.id }}-best-sellers" aria-labelledby="AlmaTab-{{ section.id }}-best-sellers">
      <alma-scroll-gallery class="alma-scroll-gallery">
        <div class="alma-favourites__grid" id="{{ product_track_id }}" data-alma-scroll-track role="region" aria-label="{{ best_selling_collection.title | escape }} products" tabindex="0">
          {%- for product in best_selling_collection.products limit: section.settings.products_to_show -%}
            <article class="alma-product">
              <a class="alma-product__image-link" href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320, 480, 720, 960, 1200', sizes: '(min-width: 990px) 25vw, 82vw', class: 'alma-product__image', alt: product.featured_image.alt | default: product.title }}
                {%- endif -%}
              </a>
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% render 'alma-static-rating', product: product %}
              {%- if product.type != blank -%}<p class="alma-product__type">{{ product.type | escape }}</p>{%- endif -%}
              {% render 'price', product: product %}
              {%- if section.settings.enable_quick_add -%}
                {%- assign alma_product_form_id = 'AlmaProductForm-' | append: section.id | append: '-' | append: product_track_id | append: '-' | append: product.id -%}
                <product-form data-section-id="{{ section.id }}" class="alma-product__form">
                  {%- form 'product', product, id: alma_product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
                    <button type="submit" name="add" class="alma-product__add-button" aria-haspopup="dialog" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}" aria-live="polite" data-sold-out-message="true" id="{{ alma_product_form_id }}-submit"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
                      <span class="alma-cta-label">
                        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
                        <span class="alma-cta-label__text">{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
                      </span>
                      <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                      {%- render 'loading-spinner' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              {%- else -%}
                <a class="alma-text-link" href="{{ product.url }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'product_link_label', value: section.settings.product_link_label %}<span class="visually-hidden"> - {{ product.title | escape }}</span></a>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
        {% render 'alma-scroll-controls', track_id: product_track_id, label: 'Product carousel controls', item_name: 'products' %}
      </alma-scroll-gallery>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign chosen_handle = block.settings.collection.handle | default: block.settings.collection -%}
    {%- assign chosen_collection = collections[chosen_handle] -%}
    {%- if chosen_collection != blank -%}
      {%- assign product_track_id = 'AlmaProducts-' | append: section.id | append: '-' | append: block.id -%}
      <div class="alma-favourites__panel" id="AlmaPanel-{{ section.id }}-{{ block.id }}" aria-labelledby="AlmaTab-{{ section.id }}-{{ block.id }}">
        <alma-scroll-gallery class="alma-scroll-gallery">
          <div class="alma-favourites__grid" id="{{ product_track_id }}" data-alma-scroll-track role="region" aria-label="{{ chosen_collection.title | escape }} products" tabindex="0">
            {%- if chosen_collection.handle == 'alma-hands-and-body-lotions-collections' -%}
              {%- for product in chosen_collection.products -%}
                {%- assign scent_option = product.options_with_values | first -%}
                {%- if scent_option != blank -%}
                  {%- for scent_value in scent_option.values -%}
                    {%- assign scent_name = scent_value.name | default: scent_value -%}
                    {%- assign scent_variant = blank -%}
                    {%- for variant in product.variants -%}
                      {%- if variant.option1 == scent_name -%}
                        {%- if scent_variant == blank or variant.available -%}
                          {%- assign scent_variant = variant -%}
                        {%- endif -%}
                        {%- if variant.available -%}{%- break -%}{%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if scent_variant != blank -%}
                      {% render 'alma-lotion-variant-card', product: product, variant: scent_variant, section_id: section.id, card_id: product_track_id, image_sizes: '(min-width: 990px) 25vw, 82vw', lazy_load: true, display_title: scent_name, allow_quick_add: false, product_link_label: 'Choose size' %}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
            {%- for product in chosen_collection.products limit: section.settings.products_to_show -%}
              <article class="alma-product">
                <a class="alma-product__image-link" href="{{ product.url }}">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320, 480, 720, 960, 1200', sizes: '(min-width: 990px) 25vw, 82vw', class: 'alma-product__image', alt: product.featured_image.alt | default: product.title }}
                  {%- endif -%}
                </a>
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                {% render 'alma-static-rating', product: product %}
                {%- if product.type != blank -%}<p class="alma-product__type">{{ product.type | escape }}</p>{%- endif -%}
                {% render 'price', product: product %}
                {%- if section.settings.enable_quick_add -%}
                {%- assign alma_product_form_id = 'AlmaProductForm-' | append: section.id | append: '-' | append: product_track_id | append: '-' | append: product.id -%}
                <product-form data-section-id="{{ section.id }}" class="alma-product__form">
                  {%- form 'product', product, id: alma_product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
                    <button type="submit" name="add" class="alma-product__add-button" aria-haspopup="dialog" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}" aria-live="polite" data-sold-out-message="true" id="{{ alma_product_form_id }}-submit"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
                      <span class="alma-cta-label">
                        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
                        <span class="alma-cta-label__text">{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
                      </span>
                      <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                      {%- render 'loading-spinner' -%}
                    </button>
                  {%- endform -%}
                </product-form>
              {%- else -%}
                <a class="alma-text-link" href="{{ product.url }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'product_link_label', value: section.settings.product_link_label %}<span class="visually-hidden"> - {{ product.title | escape }}</span></a>
              {%- endif -%}
              </article>
            {%- endfor -%}
            {%- endif -%}
          </div>
          {% render 'alma-scroll-controls', track_id: product_track_id, label: 'Product carousel controls', item_name: 'products' %}
        </alma-scroll-gallery>
      </div>
    {%- endif -%}
  {%- endfor -%}
</alma-favourites>
{%- endif -%}
{% schema %}
{
  "name":"ALMA product collection",
  "settings":[
    {"type":"text","id":"title","label":"Heading","default":"The ALMA fragrance collection"},
    {"type":"collection","id":"best_selling_collection","label":"Best selling collection","info":"This collection always appears as the first tab."},
    {"type":"text","id":"best_selling_label","label":"Best selling tab label","default":"Best Selling"},
    {"type":"range","id":"products_to_show","label":"Products per tab","min":4,"max":24,"step":4,"default":24},
    {"type":"checkbox","id":"enable_quick_add","label":"Enable Add to cart buttons","default":false},
    {"type":"text","id":"product_link_label","label":"Product link label","default":"Choose options"}
  ],
  "max_blocks":12,
  "blocks":[{"type":"collection","name":"Collection tab","settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"label","label":"Tab label","info":"Leave blank to use the collection title."}
  ]}],
  "presets":[{"name":"ALMA product collection"}]
}
{% endschema %}
