{%- liquid
  assign feature_product = section.settings.product
  assign feature_image = section.settings.image
  if feature_image == blank and feature_product != blank
    assign feature_image = feature_product.featured_image
  endif
-%}
{%- assign alma_ritual_eyebrow = section.settings.eyebrow | downcase -%}
<section class="alma-editorial alma-editorial--{{ section.settings.tone }} alma-editorial--{{ section.settings.media_position }} alma-editorial--{{ section.settings.layout | default: 'split' }}{% if alma_ritual_eyebrow == 'the alma ritual' %} alma-editorial--ritual-motion{% endif %}{% if section.settings.layout == 'immersive' and feature_product.handle == 'alma-dokhon' and section.settings.image == blank %} alma-editorial--dukhon-wide{% endif %}" aria-labelledby="AlmaEditorial-{{ section.id }}">
  <div class="alma-editorial__media">
    {%- if feature_image != blank -%}
      {%- assign feature_alt = feature_image.alt | default: section.settings.heading -%}
      {{ feature_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', class: 'alma-editorial__image', alt: feature_alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'alma-editorial__image placeholder-svg' }}
    {%- endif -%}
    {%- if alma_ritual_eyebrow == 'the alma ritual' -%}
      {%- for block in section.blocks -%}{%- assign ritual_product = block.settings.product -%}{%- if ritual_product.featured_image != blank -%}{{ ritual_product.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', class: 'alma-editorial__image alma-editorial__ritual-slide', alt: ritual_product.title }}{%- endif -%}{%- endfor -%}
    {%- endif -%}
    <div class="alma-editorial__media-copy" aria-hidden="true">
      {%- if section.settings.eyebrow != blank -%}<p class="alma-editorial__eyebrow">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'eyebrow', value: section.settings.eyebrow %}</p>{%- endif -%}
      <h2>{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'heading', value: section.settings.heading %}</h2>
    </div>
  </div>
  <div class="alma-editorial__content">
    <div class="alma-editorial__content-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="alma-editorial__eyebrow">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'eyebrow', value: section.settings.eyebrow %}</p>{%- endif -%}
      <h2 id="AlmaEditorial-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'heading', value: section.settings.heading %}</h2>
    </div>
    {%- if section.settings.text != blank -%}<div class="alma-editorial__text rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'text_html', value: section.settings.text, richtext: true %}</div>{%- endif -%}
    {%- if feature_product != blank -%}
      <div class="alma-editorial__product-line"><span>{{ feature_product.title | escape }}</span>{% render 'price', product: feature_product %}</div>
    {%- endif -%}
    {%- assign feature_link = section.settings.link -%}
    {%- if feature_link == blank and feature_product != blank -%}{%- assign feature_link = feature_product.url -%}{%- endif -%}
    {%- if section.settings.link_label != blank and feature_link != blank -%}
      <a class="alma-button" href="{{ feature_link }}">
        <span class="alma-cta-label">
          <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
          <span class="alma-cta-label__text">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'link_label', value: section.settings.link_label %}</span>
          <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
        </span>
      </a>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="alma-editorial__steps" aria-label="{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'steps_label', value: section.settings.steps_label %}">
        {%- for block in section.blocks -%}
          {%- assign step_product = block.settings.product -%}
          {%- if step_product != blank -%}
            <a class="alma-editorial__step" href="{{ step_product.url }}" {{ block.shopify_attributes }}>
              <span class="alma-editorial__step-number">0{{ forloop.index }}</span>
              {%- if step_product.featured_image != blank -%}{{ step_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '(min-width: 990px) 150px, 28vw', class: 'alma-editorial__step-image', alt: step_product.title }}{%- endif -%}
              <span class="alma-editorial__step-label">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'label', value: block.settings.label %}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- if alma_ritual_eyebrow == 'the alma ritual' and section.settings.enable_ritual_signup -%}
    {%- assign ritual_form_id = 'AlmaRitualSignupForm-' | append: section.id -%}
    {%- form 'customer', id: ritual_form_id, class: 'alma-ritual-signup-modal__form' -%}
    <dialog
      id="AlmaRitualSignup-{{ section.id }}"
      class="alma-ritual-signup-modal"
      aria-labelledby="AlmaRitualSignupHeading-{{ section.id }}"
      data-alma-ritual-signup-modal
      data-alma-ritual-signup-section="{{ section.id }}"
      {% if form.posted_successfully? %}data-signup-success="true"{% endif %}
      {% if form.errors %}data-signup-error="true"{% endif %}
    >
      <div class="alma-ritual-signup-modal__panel">
        <button class="alma-ritual-signup-modal__close" type="button" aria-label="{{ 'accessibility.close' | t }}" data-alma-ritual-signup-close>
          <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
        </button>
        {%- if form.posted_successfully? -%}
          <div class="alma-ritual-signup-modal__success" role="status">
            <p class="alma-ritual-signup-modal__eyebrow">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_eyebrow', value: section.settings.signup_eyebrow %}</p>
            <h2 id="AlmaRitualSignupHeading-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_success_heading', value: section.settings.signup_success_heading %}</h2>
            <div class="rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_success_text_html', value: section.settings.signup_success_text, richtext: true %}</div>
            {%- if section.settings.signup_discount_code != blank -%}<p class="alma-ritual-signup-modal__code"><span>{{ 'alma.signup.code' | t }}</span><strong>{{ section.settings.signup_discount_code | escape }}</strong></p>{%- endif -%}
          </div>
        {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter, alma-ritual-5-percent-off">
            <p class="alma-ritual-signup-modal__eyebrow">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_eyebrow', value: section.settings.signup_eyebrow %}</p>
            <h2 id="AlmaRitualSignupHeading-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_heading', value: section.settings.signup_heading %}</h2>
            <div class="alma-ritual-signup-modal__text rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_text_html', value: section.settings.signup_text, richtext: true %}</div>
            {%- if form.errors -%}
              <div class="alma-ritual-signup-modal__errors" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="alma-ritual-signup-modal__fields">
              <div class="field">
                <input class="field__input" id="AlmaRitualName-{{ section.id }}" type="text" name="contact[first_name]" autocomplete="given-name" placeholder="{{ 'templates.contact.form.name' | t }}">
                <label class="field__label" for="AlmaRitualName-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
              </div>
              <div class="field">
                <input class="field__input" id="AlmaRitualEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ 'templates.contact.form.email' | t }}" required>
                <label class="field__label" for="AlmaRitualEmail-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
              </div>
            </div>
            <button class="alma-button alma-ritual-signup-modal__submit" type="submit">
              <span class="alma-cta-label"><span class="alma-cta-label__text">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_button_label', value: section.settings.signup_button_label %}</span></span>
            </button>
            <p class="alma-ritual-signup-modal__fine-print">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_fine_print', value: section.settings.signup_fine_print %}</p>
        {%- endif -%}
      </div>
    </dialog>
    {%- endform -%}
    <div class="alma-ritual-signup-launcher-wrap" data-alma-ritual-signup-launcher-wrap>
      <button class="alma-ritual-signup-launcher" type="button" data-alma-ritual-signup-launcher data-alma-ritual-signup-section="{{ section.id }}" aria-controls="AlmaRitualSignup-{{ section.id }}">
        {% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'signup_launcher_label', value: section.settings.signup_launcher_label %}
      </button>
      <button class="alma-side-launcher__dismiss" type="button" aria-label="{{ 'accessibility.close' | t }}" data-alma-ritual-signup-dismiss>&times;</button>
    </div>
{%- endif -%}
{% schema %}
{"name":"ALMA editorial feature","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"An ALMA story"},{"type":"richtext","id":"text","label":"Text"},{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"image","label":"Override image"},{"type":"text","id":"link_label","label":"Link label","default":"Discover"},{"type":"url","id":"link","label":"Override link"},{"type":"text","id":"steps_label","label":"Product group label","default":"Complete the ritual"},{"type":"select","id":"layout","label":"Layout","default":"split","options":[{"value":"split","label":"Split image and text"},{"value":"immersive","label":"Full-width image then text"}]},{"type":"select","id":"media_position","label":"Media position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},{"type":"select","id":"tone","label":"Color treatment","default":"ivory","options":[{"value":"ivory","label":"Ivory"},{"value":"blush","label":"Blush"},{"value":"dark","label":"Dark"}]},{"type":"checkbox","id":"enable_ritual_signup","label":"Enable ritual 5% offer popup","default":true},{"type":"text","id":"signup_eyebrow","label":"Offer eyebrow","default":"A gift for your ritual"},{"type":"text","id":"signup_heading","label":"Offer heading","default":"Take 5% off your first ALMA ritual"},{"type":"richtext","id":"signup_text","label":"Offer text","default":"<p>Share your details for a private welcome offer and first access to new ALMA stories.</p>"},{"type":"text","id":"signup_button_label","label":"Offer button label","default":"Unlock my 5% off"},{"type":"text","id":"signup_fine_print","label":"Offer fine print","default":"By joining, you agree to receive ALMA news and offers."},{"type":"text","id":"signup_discount_code","label":"Discount code shown after signup","default":"ALMA5"},{"type":"text","id":"signup_success_heading","label":"Success heading","default":"Your welcome offer is ready"},{"type":"richtext","id":"signup_success_text","label":"Success text","default":"<p>Thank you for joining ALMA. Use your code at checkout and enjoy 5% off your first ritual.</p>"},{"type":"text","id":"signup_launcher_label","label":"Corner launcher label","default":"5% off your ritual"}],"max_blocks":3,"blocks":[{"type":"product","name":"Ritual product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"label","label":"Step label"}]}],"presets":[{"name":"ALMA editorial feature"}]}
{% endschema %}
