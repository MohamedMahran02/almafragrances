{%- liquid
  assign feature_product = section.settings.product
  assign feature_image = section.settings.image
  assign use_dukhon_campaign = false
  if feature_image == blank and section.settings.use_dukhon_campaign
    assign use_dukhon_campaign = true
  elsif feature_image == blank and feature_product != blank
    assign feature_image = feature_product.featured_image
  endif
-%}
{%- assign alma_ritual_eyebrow = section.settings.eyebrow | downcase -%}
<section class="alma-editorial alma-editorial--{{ section.settings.tone }} alma-editorial--{{ section.settings.media_position }} alma-editorial--{{ section.settings.layout | default: 'split' }}{% if alma_ritual_eyebrow == 'the alma ritual' %} alma-editorial--ritual-motion{% endif %}" aria-labelledby="AlmaEditorial-{{ section.id }}">
  <div class="alma-editorial__media">
    {%- if use_dukhon_campaign -%}
      <picture class="alma-editorial__picture">
        <source media="(max-width: 749px)" srcset="{{ 'alma-dukhon-editorial-mobile.jpg' | asset_url }}">
        <img class="alma-editorial__image" src="{{ 'alma-dukhon-editorial-desktop.jpg' | asset_url }}" width="1774" height="887" loading="lazy" alt="ALMA Dukhoon jar and lid in warm amber light">
      </picture>
    {%- elsif feature_image != blank -%}
      {%- assign feature_alt = feature_image.alt | default: section.settings.heading -%}
      {{ feature_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', class: 'alma-editorial__image', alt: feature_alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'alma-editorial__image placeholder-svg' }}
    {%- endif -%}
    {%- if alma_ritual_eyebrow == 'the alma ritual' -%}
      {%- for block in section.blocks -%}{%- assign ritual_product = block.settings.product -%}{%- if ritual_product.featured_image != blank -%}{{ ritual_product.featured_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(min-width: 990px) 55vw, 100vw', class: 'alma-editorial__image alma-editorial__ritual-slide', alt: ritual_product.title }}{%- endif -%}{%- endfor -%}
    {%- endif -%}
    <div class="alma-editorial__media-copy" aria-hidden="true">
      {%- if section.settings.eyebrow != blank -%}<p class="alma-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  </div>
  <div class="alma-editorial__content">
    <div class="alma-editorial__content-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="alma-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="AlmaEditorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.text != blank -%}<div class="alma-editorial__text rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if feature_product != blank -%}
      <div class="alma-editorial__product-line"><span>{{ feature_product.title | escape }}</span>{% render 'price', product: feature_product %}</div>
    {%- endif -%}
    {%- assign feature_link = section.settings.link -%}
    {%- if feature_link == blank and feature_product != blank -%}{%- assign feature_link = feature_product.url -%}{%- endif -%}
    {%- if section.settings.link_label != blank and feature_link != blank -%}
      <a class="alma-button" href="{{ feature_link }}">
        <span class="alma-cta-label">
          <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
          <span class="alma-cta-label__text">{{ section.settings.link_label | escape }}</span>
          <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
        </span>
      </a>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="alma-editorial__steps" aria-label="{{ section.settings.steps_label | escape }}">
        {%- for block in section.blocks -%}
          {%- assign step_product = block.settings.product -%}
          {%- if step_product != blank -%}
            <a class="alma-editorial__step" href="{{ step_product.url }}" {{ block.shopify_attributes }}>
              <span class="alma-editorial__step-number">0{{ forloop.index }}</span>
              {%- if step_product.featured_image != blank -%}{{ step_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '160, 240, 360', sizes: '(min-width: 990px) 150px, 28vw', class: 'alma-editorial__step-image', alt: step_product.title }}{%- endif -%}
              <span class="alma-editorial__step-label">{{ block.settings.label | default: step_product.title | escape }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"ALMA editorial feature","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"An ALMA story"},{"type":"richtext","id":"text","label":"Text"},{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"image","label":"Override image"},{"type":"checkbox","id":"use_dukhon_campaign","label":"Use responsive ALMA Dukhoon campaign","default":false},{"type":"text","id":"link_label","label":"Link label","default":"Discover"},{"type":"url","id":"link","label":"Override link"},{"type":"text","id":"steps_label","label":"Product group label","default":"Complete the ritual"},{"type":"select","id":"layout","label":"Layout","default":"split","options":[{"value":"split","label":"Split image and text"},{"value":"immersive","label":"Full-width image then text"}]},{"type":"select","id":"media_position","label":"Media position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},{"type":"select","id":"tone","label":"Color treatment","default":"ivory","options":[{"value":"ivory","label":"Ivory"},{"value":"blush","label":"Blush"},{"value":"dark","label":"Dark"}]}],"max_blocks":3,"blocks":[{"type":"product","name":"Ritual product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"label","label":"Step label"}]}],"presets":[{"name":"ALMA editorial feature"}]}
{% endschema %}
