{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alma-scent-finder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign finder_collection = section.settings.collection
  if finder_collection == blank
    assign finder_collection = collections.all
  endif
-%}

{%- if finder_collection.products != blank and section.blocks != blank -%}
  <alma-scent-finder class="alma-scent-finder" data-result-limit="{{ section.settings.results_limit }}">
    <div class="alma-scent-finder__intro page-width">
      <div class="alma-scent-finder__heading">
        <h2 id="AlmaScentFinder-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <div class="alma-scent-finder__text rte">{{ section.settings.text }}</div>
      </div>

      <fieldset class="alma-scent-finder__notes" aria-describedby="AlmaScentFinderHelp-{{ section.id }}">
        <legend>{{ section.settings.prompt | escape }}</legend>
        <p id="AlmaScentFinderHelp-{{ section.id }}" class="visually-hidden">Select one or more fragrance notes to see matching perfumes.</p>
        <div class="alma-scent-finder__note-grid">
          {%- for block in section.blocks -%}
            {%- assign note_value = block.settings.value | default: block.settings.label | downcase -%}
            <label class="alma-scent-finder__note" {{ block.shopify_attributes }}>
              <input type="checkbox" value="{{ note_value | escape }}" data-note-label="{{ block.settings.label | escape }}">
              <span>{{ block.settings.label | escape }}</span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>

      <div class="alma-scent-finder__actions">
        <p class="alma-scent-finder__status" role="status" aria-live="polite">{{ section.settings.initial_message | escape }}</p>
        <button class="alma-scent-finder__clear" type="button" hidden>Clear selection</button>
      </div>
    </div>

    <div class="alma-scent-finder__results-wrap page-width" hidden>
      <div class="alma-scent-finder__results" role="region" aria-label="Recommended perfumes" tabindex="0">
        {%- for product in finder_collection.products limit: 50 -%}
          {%- liquid
            assign note_references = product.metafields.custom.fragrance_note_refs.value
            assign note_metafield = product.metafields.custom.fragrance_notes.value
            capture note_source
              echo product.title
              echo ' '
              echo product.tags | join: ' '
              echo ' '
              echo product.description | strip_html
              echo ' '
              for note_reference in note_references
                assign reference_name = note_reference.name.value | default: note_reference.name
                echo reference_name
                echo ' '
              endfor
              echo note_metafield | join: ' '
            endcapture
          -%}
          <article class="alma-scent-match" data-scent-source="{{ note_source | strip_newlines | downcase | escape }}" hidden>
            <a class="alma-scent-match__image-link" href="{{ product.url }}">
              {%- if product.featured_image -%}
                <img
                  class="alma-scent-match__image"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                >
              {%- endif -%}
            </a>
            <p class="alma-scent-match__reason"></p>
            <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {%- if product.type != blank -%}<p class="alma-scent-match__type">{{ product.type | escape }}</p>{%- endif -%}
            {% render 'price', product: product %}
            <a class="alma-text-link" href="{{ product.url }}">Discover<span class="visually-hidden"> — {{ product.title | escape }}</span></a>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </alma-scent-finder>
{%- endif -%}

{% schema %}
{
  "name": "ALMA scent finder",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Find Your Aura"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose the notes you love. We’ll reveal the ALMA fragrances that share your scent.</p>"},
    {"type": "text", "id": "prompt", "label": "Selection prompt", "default": "Which notes draw you in?"},
    {"type": "text", "id": "initial_message", "label": "Initial message", "default": "Select one or more notes to begin."},
    {"type": "collection", "id": "collection", "label": "Perfume collection", "info": "Products and prices stay connected to Shopify. Select reusable entries in custom.fragrance_note_refs. Tags, descriptions and the legacy custom.fragrance_notes field remain matching fallbacks."},
    {"type": "range", "id": "results_limit", "label": "Maximum recommendations", "min": 2, "max": 8, "step": 1, "default": 4}
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Fragrance note",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Vanilla"},
        {"type": "text", "id": "value", "label": "Matching word", "info": "Optional. Defaults to the lowercase label."}
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "ALMA scent finder",
      "blocks": [
        {"type": "note", "settings": {"label": "Vanilla"}},
        {"type": "note", "settings": {"label": "Oud"}},
        {"type": "note", "settings": {"label": "Musk"}},
        {"type": "note", "settings": {"label": "Amber"}},
        {"type": "note", "settings": {"label": "Rose"}},
        {"type": "note", "settings": {"label": "Citrus"}}
      ]
    }
  ]
}
{% endschema %}
