{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alma-scent-finder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign finder_collection = section.settings.collection
  if finder_collection == blank or finder_collection.products == blank
    assign finder_collection = collections.all
  endif
  assign finder_notes = metaobjects.fragrance_note.values
  if finder_notes == blank
    assign finder_notes = section.settings.fallback_notes | split: ','
  endif
-%}

{%- if finder_collection.products != blank -%}
  <dialog id="AlmaScentFinder" class="alma-scent-finder-modal" aria-labelledby="AlmaScentFinder-{{ section.id }}" data-alma-scent-finder-modal>
    <div class="alma-scent-finder-modal__panel">
      <form method="dialog">
        <button class="alma-scent-finder-modal__close" type="submit" aria-label="{{ 'accessibility.close' | t }}" data-alma-scent-finder-close>
          <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
        </button>
      </form>
      <div class="alma-scent-finder-modal__scroll">
  <alma-scent-finder class="alma-scent-finder" data-result-limit="{{ section.settings.results_limit }}" data-match-label="{{ 'alma.finder.matches' | t }}" data-found-one="{{ 'alma.finder.found_one' | t }}" data-found-many="{{ 'alma.finder.found_many' | t }}" data-no-match="{{ 'alma.finder.no_match' | t }}">
    <div class="alma-scent-finder__intro page-width">
      <div class="alma-scent-finder__heading">
        <p class="alma-scent-finder__eyebrow">{{ 'alma.brand' | t }}</p>
        <h2 id="AlmaScentFinder-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'heading', value: section.settings.heading %}</h2>
        <div class="alma-scent-finder__text rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'text_html', value: section.settings.text, richtext: true %}</div>
      </div>

      <fieldset class="alma-scent-finder__notes" aria-describedby="AlmaScentFinderHelp-{{ section.id }}">
        <legend>{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'prompt', value: section.settings.prompt %}</legend>
        <p id="AlmaScentFinderHelp-{{ section.id }}" class="visually-hidden">{{ 'alma.finder.help' | t }}</p>
        <div class="alma-scent-finder__note-grid">
          {%- for note in finder_notes -%}
            {%- assign note_label = note.name.value | default: note.name | strip -%}
            <label class="alma-scent-finder__note">
              {%- capture localized_note -%}{% render 'alma-note-name', name: note_label %}{%- endcapture -%}
              <input type="checkbox" value="{{ note_label | downcase | escape }}" data-note-label="{{ localized_note | escape }}">
              <span>{{ localized_note }}</span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>

      <div class="alma-scent-finder__actions">
        <p class="alma-scent-finder__status" role="status" aria-live="polite">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'initial_message', value: section.settings.initial_message %}</p>
        <button class="alma-scent-finder__clear" type="button" hidden>{{ 'alma.finder.clear' | t }}</button>
      </div>
    </div>

    <div class="alma-scent-finder__results-wrap page-width" hidden>
      <div class="alma-scent-finder__results" role="region" aria-label="{{ 'alma.finder.recommended' | t }}" tabindex="0">
        {%- for product in finder_collection.products limit: 50 -%}
          {%- liquid
            assign note_references = product.metafields.custom.fragrance_note_refs.value
            assign note_metafield = product.metafields.custom.fragrance_notes.value
            capture note_source
              echo product.title
              echo ' '
              echo product.tags | join: ' '
              echo ' '
              echo product.description | strip_html
              echo ' '
              for note_reference in note_references
                assign reference_name = note_reference.name.value | default: note_reference.name
                echo reference_name
                echo ' '
              endfor
              echo note_metafield | join: ' '
            endcapture
          -%}
          <article class="alma-scent-match" data-scent-source="{{ note_source | strip_newlines | downcase | escape }}" hidden>
            <a class="alma-scent-match__image-link" href="{{ product.url }}">
              {%- if product.featured_image -%}
                <img
                  class="alma-scent-match__image"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                >
              {%- endif -%}
            </a>
            <p class="alma-scent-match__reason"></p>
            <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% render 'alma-static-rating', product: product %}
            {%- if product.type != blank -%}<p class="alma-scent-match__type">{{ product.type | escape }}</p>{%- endif -%}
            {% render 'price', product: product %}
            <a class="alma-text-link" href="{{ product.url }}">{{ 'alma.discover' | t }}<span class="visually-hidden"> — {{ product.title | escape }}</span></a>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </alma-scent-finder>
      </div>
    </div>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "ALMA scent finder",
  "settings": [
    {"type": "paragraph", "content": "This opening pop-up updates automatically from Content > Metaobjects > Fragrance note. Add or rename notes there; no section blocks are required."},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Find Your Aura"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose the notes you love. We’ll reveal the ALMA fragrances that share your scent.</p>"},
    {"type": "text", "id": "prompt", "label": "Selection prompt", "default": "Which notes draw you in?"},
    {"type": "text", "id": "initial_message", "label": "Initial message", "default": "Select one or more notes to begin."},
    {"type": "collection", "id": "collection", "label": "Perfume collection", "info": "Products and prices stay connected to Shopify. Select reusable entries in custom.fragrance_note_refs. Tags, descriptions and the legacy custom.fragrance_notes field remain matching fallbacks."},
    {"type": "text", "id": "fallback_notes", "label": "Fallback scent notes", "default": "Oud, Musk, Amber, Saffron, Rose, Vanilla, Sandalwood, Jasmine", "info": "Shown when no Fragrance note metaobjects exist. Separate notes with commas."},
    {"type": "range", "id": "results_limit", "label": "Maximum recommendations", "min": 2, "max": 8, "step": 1, "default": 4}
  ],
  "presets": [
    {
      "name": "ALMA scent finder"
    }
  ]
}
{% endschema %}
