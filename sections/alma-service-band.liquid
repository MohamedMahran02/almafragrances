{% comment %}
  Text-only service layout. Keep this marker in the section output so connected
  Shopify themes can be checked for stale image-based markup after Git sync.
{% endcomment %}
<section class="alma-service-band alma-service-band--text page-width" data-alma-service-layout="text" aria-labelledby="AlmaService-{{ section.id }}">
  <div class="alma-service-band__inner">
    <h2 id="AlmaService-{{ section.id }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, field: 'heading', value: section.settings.heading %}</h2>
    <div class="alma-service-band__grid">
      {%- for block in section.blocks -%}
        <div class="alma-service-band__item" {{ block.shopify_attributes }}>
          <span class="alma-service-band__mark" aria-hidden="true">0{{ forloop.index }}</span>
          <h3>{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'heading', value: block.settings.heading %}</h3>
          {%- if block.settings.text != blank -%}<div class="rte">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'text_html', value: block.settings.text, richtext: true %}</div>{%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}<a class="alma-text-link" href="{{ block.settings.link }}">{% render 'alma-localized-copy', scope: 'home', section_id: section.id, block_id: block.id, field: 'link_label', value: block.settings.link_label %}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"ALMA services","settings":[{"type":"text","id":"heading","label":"Heading","default":"At your service"}],"max_blocks":4,"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"ALMA services","blocks":[{"type":"service"},{"type":"service"},{"type":"service"}]}]}
{% endschema %}
