{%- liquid
  assign link_class = 'header__menu-item list-menu__item link link--text focus-inset'
  if mobile
    assign link_class = 'menu-drawer__menu-item list-menu__item link link--text focus-inset'
  endif

  assign gifting_url = collections['gifting'].url | default: '/collections/gifting'
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign spray_collection = collections['alma-perfumes']
  assign solid_collection = collections['alma-makhmaria-s-solid-perfume']
  assign lotions_collection = collections['alma-hands-and-body-lotions-collections']
  assign dokhon_collection = collections['alma-dokhon']
  assign charms_collection = collections['alma-solid-charms']
  assign spray_collection_url = spray_collection.url | default: '/collections/alma-perfumes'
  assign solid_collection_url = solid_collection.url | default: '/collections/alma-makhmaria-s-solid-perfume'
  assign lotions_collection_url = lotions_collection.url | default: '/collections/alma-hands-and-body-lotions-collections'
  assign dokhon_collection_url = dokhon_collection.url | default: '/collections/alma-dokhon'
  assign charms_collection_url = charms_collection.url | default: '/collections/alma-solid-charms'
  assign layering_page_url = pages['layering'].url | default: '/pages/layering'
  assign layering_page_title = pages['layering'].title | default: 'Layering'
-%}
{%- if mobile -%}
  <li>
    <details id="Details-menu-drawer-alma-products">
      <summary id="HeaderDrawer-AlmaProducts" class="{{ link_class }}{% if request.path == routes.all_products_collection_url %} menu-drawer__menu-item--active{% endif %}">
        {{ 'alma.nav.products' | t }}
        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </summary>
      <div id="link-alma-products" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
        <div class="menu-drawer__inner-submenu">
          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
            {{ 'alma.nav.products' | t }}
          </button>
          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
            <li><a class="{{ link_class }}" href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>{{ 'alma.nav.shop_all' | t }}</a></li>
            <li><a class="{{ link_class }}" href="{{ spray_collection_url }}">{{ spray_collection.title | default: 'Alma Spray Perfumes' | escape }}</a></li>
            <li><a class="{{ link_class }}" href="{{ solid_collection_url }}">{{ solid_collection.title | default: 'Alma Solids Perfumes' | escape }}</a></li>
            <li><a class="{{ link_class }}" href="{{ lotions_collection_url }}">{{ lotions_collection.title | default: 'Alma Lotions' | escape }}</a></li>
            <li><a class="{{ link_class }}" href="{{ dokhon_collection_url }}">{{ dokhon_collection.title | default: 'Alma Dukhoon' | escape }}</a></li>
            <li><a class="{{ link_class }}" href="{{ charms_collection_url }}">{{ charms_collection.title | default: 'Alma Solid Charms' | escape }}</a></li>
          </ul>
        </div>
      </div>
    </details>
  </li>
{%- else -%}
  <li class="alma-products-menu">
    <header-menu>
      <details id="Details-AlmaProductsMenu">
        <summary id="HeaderMenu-AlmaProducts" class="header__menu-item list-menu__item link focus-inset">
          <span{% if request.path == routes.all_products_collection_url %} class="header__active-menu-item"{% endif %}>{{ 'alma.nav.products' | t }}</span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <ul class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup" role="list" tabindex="-1">
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ routes.all_products_collection_url }}">{{ 'alma.nav.shop_all' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ spray_collection_url }}">{{ spray_collection.title | default: 'Alma Spray Perfumes' | escape }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ solid_collection_url }}">{{ solid_collection.title | default: 'Alma Solids Perfumes' | escape }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ lotions_collection_url }}">{{ lotions_collection.title | default: 'Alma Lotions' | escape }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ dokhon_collection_url }}">{{ dokhon_collection.title | default: 'Alma Dukhoon' | escape }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ charms_collection_url }}">{{ charms_collection.title | default: 'Alma Solid Charms' | escape }}</a></li>
        </ul>
      </details>
    </header-menu>
  </li>
{%- endif -%}
<li><a class="{{ link_class }}" href="{{ layering_page_url }}"{% if request.path == layering_page_url %} aria-current="page"{% endif %}>{{ layering_page_title | escape }}</a></li>
<li><a class="{{ link_class }}" href="{{ gifting_url }}"{% if request.path == gifting_url %} aria-current="page"{% endif %}>{{ 'alma.nav.gifting' | t }}</a></li>
<li><a class="{{ link_class }}" href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>{{ 'alma.nav.contact' | t }}</a></li>
