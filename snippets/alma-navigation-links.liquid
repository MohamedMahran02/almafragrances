{%- liquid
  assign link_class = 'header__menu-item list-menu__item link link--text focus-inset'
  if mobile
    assign link_class = 'menu-drawer__menu-item list-menu__item link link--text focus-inset'
  endif

  assign gifting_url = collections['layering-kits'].url | default: '/collections/layering-kits'
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign spray_collection_url = collections['alma-perfumes'].url | default: '/collections/alma-perfumes'
  assign solid_collection_url = collections['alma-solids-مخمريات'].url | default: '/collections/alma-solids-مخمريات'
  assign lotions_collection_url = collections['alma-lotions'].url | default: '/collections/alma-lotions'
  assign dokhon_collection_url = collections['alma-dokhon'].url | default: '/collections/alma-dokhon'
  assign charms_collection_url = collections['alma-solid-charms'].url | default: '/collections/alma-solid-charms'
  assign layering_page_url = pages['layering'].url | default: '/pages/layering'
  assign layering_page_title = pages['layering'].title | default: 'Layering'
-%}
{%- if mobile -%}
  <li><a class="{{ link_class }}" href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>{{ 'alma.nav.products' | t }}</a></li>
{%- else -%}
  <li class="alma-products-menu">
    <header-menu>
      <details id="Details-AlmaProductsMenu">
        <summary id="HeaderMenu-AlmaProducts" class="header__menu-item list-menu__item link focus-inset">
          <span{% if request.path == routes.all_products_collection_url %} class="header__active-menu-item"{% endif %}>{{ 'alma.nav.products' | t }}</span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <ul class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup" role="list" tabindex="-1">
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ routes.all_products_collection_url }}">{{ 'alma.nav.shop_all' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ spray_collection_url }}">{{ 'alma.home.wardrobe.spray.label' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ solid_collection_url }}">{{ 'alma.home.wardrobe.solid.label' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ lotions_collection_url }}">{{ 'alma.nav.lotions' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ dokhon_collection_url }}">{{ 'alma.nav.dukhon' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ charms_collection_url }}">{{ 'alma.nav.charms' | t }}</a></li>
          <li><a class="header__menu-item list-menu__item link link--text focus-inset caption-large" href="{{ layering_page_url }}">{{ 'alma.nav.layering' | t }}</a></li>
        </ul>
      </details>
    </header-menu>
  </li>
{%- endif -%}
<li><a class="{{ link_class }}" href="{{ layering_page_url }}"{% if request.path == layering_page_url %} aria-current="page"{% endif %}>{{ layering_page_title | escape }}</a></li>
<li><a class="{{ link_class }}" href="{{ gifting_url }}"{% if request.path == gifting_url %} aria-current="page"{% endif %}>{{ 'alma.nav.gifting' | t }}</a></li>
<li><a class="{{ link_class }}" href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>{{ 'alma.nav.contact' | t }}</a></li>
