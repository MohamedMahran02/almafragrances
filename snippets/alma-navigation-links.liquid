{%- liquid
  assign link_class = 'header__menu-item list-menu__item link link--text focus-inset'
  if mobile
    assign link_class = 'menu-drawer__menu-item list-menu__item link link--text focus-inset'
  endif

  assign gifting_url = settings.alma_gifting_link | default: '/#shopify-section-gifting_story'
  assign contact_url = pages.contact.url | default: '/pages/contact'
-%}
<li><a class="{{ link_class }}" href="{{ routes.all_products_collection_url }}"{% if request.path == routes.all_products_collection_url %} aria-current="page"{% endif %}>Products</a></li>
<li><a class="{{ link_class }}" href="/products/alma-layering-box"{% if request.path == '/products/alma-layering-box' %} aria-current="page"{% endif %}>Sale</a></li>
<li><a class="{{ link_class }}" href="{{ routes.root_url }}#AlmaScentFinder">Find Your Aura</a></li>
<li><a class="{{ link_class }}" href="{{ gifting_url }}"{% if request.path == gifting_url %} aria-current="page"{% endif %}>Gifting</a></li>
<li><a class="{{ link_class }}" href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact</a></li>
