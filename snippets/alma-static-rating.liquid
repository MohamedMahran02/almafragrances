{%- liquid
  assign alma_review_count = product.id | modulo: 31 | plus: 20
-%}
<div class="alma-static-rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: 5, rating_max: 5 }}">
  <span class="alma-static-rating__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
  <span class="alma-static-rating__count" aria-label="{{ alma_review_count }} reviews">({{ alma_review_count }})</span>
</div>
