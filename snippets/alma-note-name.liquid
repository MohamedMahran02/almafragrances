{%- if request.locale.iso_code == 'ar' -%}
  {%- assign note_key = name | downcase | strip -%}
  {%- assign known_notes = 'almond,amber,bakhoor,caramel,citrus,cocoa,coconut,floral,fruity,jasmine,leather,musk,oud,pear,powder,rose,saffron,sandalwood,spices,tobacco,vanilla,woody' | split: ',' -%}
  {%- if known_notes contains note_key -%}
    {%- assign translation_key = 'alma.notes.' | append: note_key -%}
    {{- translation_key | t -}}
  {%- else -%}
    {{- name | escape -}}
  {%- endif -%}
{%- else -%}
  {{- name | escape -}}
{%- endif -%}
