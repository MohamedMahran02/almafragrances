<div class="alma-scroll-gallery__footer">
  <span class="alma-scroll-gallery__progress" aria-hidden="true"><span class="alma-scroll-gallery__progress-value"></span></span>
  <div class="alma-scroll-gallery__controls" aria-label="{{ label | escape }}">
    <button class="alma-scroll-gallery__button" type="button" data-alma-scroll-previous aria-controls="{{ track_id }}" aria-label="Previous {{ item_name | escape }}" disabled>
      <span aria-hidden="true">←</span>
    </button>
    <button class="alma-scroll-gallery__button" type="button" data-alma-scroll-next aria-controls="{{ track_id }}" aria-label="Next {{ item_name | escape }}" disabled>
      <span aria-hidden="true">→</span>
    </button>
  </div>
</div>
