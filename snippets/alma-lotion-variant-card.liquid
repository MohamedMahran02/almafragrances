{%- comment -%}
  Renders one Shopify product variant as a lotion card.
  Accepts: product, variant, section_id, card_id, image_sizes, lazy_load, display_title, allow_quick_add, product_link_label, show_product_title, show_action.
{%- endcomment -%}
{%- liquid
  assign lotion_variant_url = product.url | append: '?variant=' | append: variant.id
  assign lotion_variant_image = variant.featured_media.preview_image | default: variant.image | default: product.featured_image
  assign lotion_variant_title = display_title | default: variant.title
  if lotion_variant_title == blank or lotion_variant_title == 'Default Title'
    assign lotion_variant_title = product.title
  endif
  assign lotion_form_id = 'AlmaLotionVariantForm-' | append: section_id | append: '-' | append: card_id | append: '-' | append: variant.id
  assign lotion_image_sizes = image_sizes | default: '(min-width: 990px) 25vw, 82vw'
  assign lotion_loading = 'lazy'
  if lazy_load == false
    assign lotion_loading = 'eager'
  endif
  assign use_lotion_quick_add = true
  if allow_quick_add == false
    assign use_lotion_quick_add = false
  endif
  assign show_lotion_product_title = true
  if show_product_title == false
    assign show_lotion_product_title = false
  endif
  assign show_lotion_action = true
  if show_action == false
    assign show_lotion_action = false
  endif
-%}
<article class="alma-lotion-variant-card">
  <a class="alma-lotion-variant-card__image-link" href="{{ lotion_variant_url }}">
    {%- if lotion_variant_image != blank -%}
      {{ lotion_variant_image | image_url: width: 1200 | image_tag: loading: lotion_loading, widths: '320, 480, 720, 960, 1200', sizes: lotion_image_sizes, class: 'alma-lotion-variant-card__image', alt: lotion_variant_image.alt | default: lotion_variant_title }}
    {%- endif -%}
  </a>
  <div class="alma-lotion-variant-card__information card-information">
    {%- if show_lotion_product_title -%}
      <p class="alma-lotion-variant-card__eyebrow">{{ product.title | escape }}</p>
    {%- endif -%}
    <h3 class="card__heading h5"><a href="{{ lotion_variant_url }}">{{ lotion_variant_title | escape }}</a></h3>
    {% render 'alma-static-rating', product: product %}
    {% render 'price', product: product, target_variant: variant %}
  </div>
  {%- if show_lotion_action and use_lotion_quick_add -%}
    <product-form data-section-id="{{ section_id }}" class="alma-product__form">
      {%- form 'product', product, id: lotion_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id"{% unless variant.available %} disabled{% endunless %}>
        <button type="submit" name="add" class="alma-product__add-button" aria-haspopup="dialog" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ lotion_variant_title | escape }}" aria-live="polite" data-sold-out-message="true" id="{{ lotion_form_id }}-submit"{% unless variant.available %} disabled{% endunless %}>
          <span class="alma-cta-label">
            <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
            <span class="alma-cta-label__text">{% if variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
          </span>
          <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
          {%- render 'loading-spinner' -%}
        </button>
      {%- endform -%}
    </product-form>
  {%- elsif show_lotion_action -%}
    <a class="alma-product__add-button" href="{{ lotion_variant_url }}" aria-label="{{ product_link_label | default: 'Choose size' }}: {{ lotion_variant_title | escape }}">
      <span class="alma-cta-label">
        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
        <span class="alma-cta-label__text">{{ product_link_label | default: 'Choose size' }}</span>
        <img class="alma-cta-label__dot" src="{{ 'alma-cta-dot.svg' | asset_url }}" width="17" height="16" alt="" aria-hidden="true">
      </span>
    </a>
  {%- endif -%}
</article>
